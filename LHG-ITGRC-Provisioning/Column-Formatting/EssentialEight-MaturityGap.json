{
  "$schema": "https://developer.microsoft.com/json-schemas/sp/v2/column-formatting.schema.json",
  "elmType": "div",
  "style": {
    "display": "flex",
    "align-items": "center",
    "justify-content": "center"
  },
  "children": [
    {
      "elmType": "span",
      "style": {
        "font-size": "16px",
        "color": "=if(@currentField == 0, '#0F6E56', if(@currentField == 1, '#9A5E10', '#B3261E'))"
      },
      "attributes": {
        "iconName": "=if(@currentField == 0, 'CheckMark', if(@currentField == 1, 'Warning', 'ErrorBadge'))",
        "class": "ms-Icon"
      }
    }
  ]
}
