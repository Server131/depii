{
  "$schema": "https://developer.microsoft.com/json-schemas/sp/v2/column-formatting.schema.json",
  "elmType": "div",
  "style": {
    "display": "inline-block",
    "border-radius": "20px",
    "padding": "3px 12px",
    "font-weight": "600",
    "font-size": "12px",
    "background-color": "=if(@currentField == 'Level 0', '#FBE3E1', if(@currentField == 'Level 1', '#FAEEDA', if(@currentField == 'Level 2', '#FBF3D6', if(@currentField == 'Level 3', '#E1F5EE', '#F0F0F0'))))",
    "color": "=if(@currentField == 'Level 0', '#B3261E', if(@currentField == 'Level 1', '#9A5E10', if(@currentField == 'Level 2', '#8A6D00', if(@currentField == 'Level 3', '#0F6E56', '#777777'))))"
  },
  "txtContent": "@currentField"
}
